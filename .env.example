# Copy this file to .env.local and fill in real values there. .env.local is
# never committed to git (see .gitignore) — this .env.example file is just a
# checklist of which settings the app expects, with no real secrets in it.
# See src/lib/env.ts for how these are validated.

# Required. The site's own public address (no trailing slash). Used to build
# absolute URLs for SEO metadata, the sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Both must be set together to enable emailing quote requests via
# Resend (https://resend.com) — leave both blank to just log requests
# on the server instead.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
