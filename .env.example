# Copy this file to .env.local and fill in real values there. .env.local is
# never committed to git (see .gitignore) — this .env.example file is just a
# checklist of which settings the app expects, with no real secrets in it.
# See src/lib/env.ts for how these are validated.

# Optional. The site's own public address (no trailing slash). Used to
# build absolute URLs for SEO metadata, the sitemap, and structured data.
# Defaults to this site's real production domain if unset, so you only need
# to set it for a deployment on a different domain (e.g. a staging site).
# Leave this unset (or delete this line) for local development — `npm run
# build` deliberately fails if this is set to "localhost" or "example.com"
# (see src/lib/env.ts), so don't copy the placeholder below as-is.
# NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Optional. Both must be set together to enable emailing quote requests via
# Resend (https://resend.com) — leave both blank to just log requests
# on the server instead.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
